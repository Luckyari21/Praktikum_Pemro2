<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.scene.layout.VBox?>
        <?import javafx.scene.control.TableView?>
        <?import javafx.scene.control.TableColumn?>

<VBox prefHeight="400.0" prefWidth="800.0"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="io.github.luckyari21.module06.StudentController">

<TableView fx:id="studentTable">
  <columns>
    <TableColumn fx:id="studentIdCol" text="NIM"/>
    <TableColumn fx:id="studentNameCol" text="Nama"/>
  </columns>
</TableView>
</VBox>